PORT=5000
DB_NAME=pizzaHubDB

# MongoDB Connection String
MONGODB_URL=mongodb://username:password@cluster.mongodb.net/?ssl=true&replicaSet=atlas-xxx&authSource=admin
MONGODB_URI=mongodb://username:password@cluster.mongodb.net/?ssl=true&replicaSet=atlas-xxx&authSource=admin

CLIENT_URL=http://localhost:3000

# Better Auth & JWT Shared Secret
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here

# Image Hosting & Stripe (Optional / Sandbox)
IMGBB_API_KEY=your_imgbb_api_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
